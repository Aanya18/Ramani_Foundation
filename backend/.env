ki# Core Project Settings
PROJECT_NAME="Ramani Foundation API"
API_V1_STR="/api/v1"
ROOT_MESSAGE="Welcome to the Ramani Foundation API"

# Security Settings
# This is a placeholder secret key. In a real production environment, this should be a long, random, and securely managed string.
SECRET_KEY="your-super-secret-and-long-random-key-that-is-at-least-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
JWT_ALGORITHM="HS256"
HASHING_SCHEME="argon2"
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# CORS Settings
# A comma-separated list of allowed origins.
# Example: "http://localhost:3000,https://www.your-frontend-domain.com"
BACKEND_CORS_ORIGINS="http://localhost:3000,https://ramani-foundation.vercel.app","https://ramani-foundation-azure.vercel.app"

# Database Settings
# The URL for the database connection.
DATABASE_URL="postgresql://neondb_owner:npg_ptSI12wEFhKn@ep-lively-firefly-a1dr2h2f.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_POOL_PRE_PING=True

# File Uploads
UPLOADS_DIR="uploads"
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp"

# Authentication URL
AUTH_TOKEN_URL="/api/v1/auth/login"

# Server Settings
PORT=8000
HOST="0.0.0.0"

# Caching Settings
CACHE_DIR="cache"
DEFAULT_CACHE_EXPIRE_SECONDS=300
IMAGE_CACHE_MAX_BYTES=104857600 # 100MB

# Mega.nz Settings
MEGA_USER="foundationramani@gmail.com"
MEGA_PASSWORD="paytm@ramanifoundation"
MEGA_ROOT_FOLDER="NGO_UPLOADS"

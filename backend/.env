# Core Project Settings
PROJECT_NAME="Ramani Foundation API"
API_V1_STR="/api/v1"
ROOT_MESSAGE="Welcome to the Ramani Foundation API"

# Security Settings
# This is a placeholder secret key. In a real production environment, this should be a long, random, and securely managed string.
SECRET_KEY="your-super-secret-and-long-random-key-that-is-at-least-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
JWT_ALGORITHM="HS256"
HASHING_SCHEME="bcrypt"

# CORS Settings
# A comma-separated list of allowed origins.
# Example: "http://localhost:3000,https://www.your-frontend-domain.com"
BACKEND_CORS_ORIGINS="http://localhost:3000"

# Database Settings
# The URL for the database connection.
DATABASE_URL="sqlite+aiosqlite:///../database.db"

# File Uploads
UPLOADS_DIR="uploads"
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp"

# Authentication URL
AUTH_TOKEN_URL="/api/v1/auth/login"
